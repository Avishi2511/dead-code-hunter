# Backend settings (all optional locally; see backend/src/dch_api/settings.py)
DATABASE_URL=postgresql://user:password@host/dbname   # default: sqlite:///./dch_dev.db
GITHUB_TOKEN=                                          # raises the GitHub rate limit
JOB_RUNNER=inline                                      # inline (serverless) | background (long-lived process)
VERIFIER=auto                                          # auto | basedpyright | jedi | none
SCAN_TIME_BUDGET_S=40
MAX_PY_FILES=1000
MAX_TARBALL_MB=30
MAINTENANCE_TOKEN=                                     # bearer token for /api/maintenance/purge
SERVE_STATIC=false                                     # serve frontend/dist from the API process
